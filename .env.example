# Copia este archivo como .env.local y llena los valores. NUNCA subas .env.local.

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=            # genera uno: npx auth secret  o  openssl rand -hex 32

# Google OAuth (console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (github.com/settings/developers)
GITHUB_ID=
GITHUB_SECRET=

# Supabase (Project Settings -> API Keys / Data API)
SUPABASE_URL=
SUPABASE_SECRET_KEY=        # la "secret key" (sb_secret_...), solo servidor
